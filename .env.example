# Copy to .env.local and fill in locally. Never commit actual credentials.
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Legacy key names requested in the mission. Use these OR the modern pair below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Modern Supabase keys (preferred for new projects)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local development; replace with the HTTPS deployment URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe sandbox only during development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Smart lock adapter: no real gate access in mock mode.
SMART_LOCK_PROVIDER=mock
SMART_LOCK_API_KEY=
SMART_LOCK_LOCK_ID=

# Playtomic sandbox: leave production credentials empty until onboarding.
PLAYTOMIC_SANDBOX=true
PLAYTOMIC_API_KEY=
PLAYTOMIC_CLUB_ID=
